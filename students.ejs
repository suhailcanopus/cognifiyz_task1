<%- include('partials/header') %>

<main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <!-- Header Section with Breadcrumb & Action -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-slate-200 mb-6 gap-4">
    <div>
      <div class="flex items-center space-x-2 text-xs text-slate-500 mb-1">
        <a href="/" class="hover:text-indigo-600">Home</a>
        <span>/</span>
        <span class="text-slate-800 font-medium">Students Roster</span>
      </div>
      <h1 class="text-2xl font-black text-slate-900 flex items-center gap-2">
        <i class="fa-solid fa-users text-indigo-600"></i>
        Enrolled Students Directory (SSR View)
      </h1>
      <p class="text-xs text-slate-500 mt-1">
        Dynamically generated on the server using EJS iteration (<code class="text-indigo-600 font-mono">&lt;% students.forEach(...) %&gt;</code>)
      </p>
    </div>

    <div class="flex items-center space-x-3">
      <a href="/" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold shadow-sm transition flex items-center gap-1.5">
        <i class="fa-solid fa-plus text-[10px]"></i>
        <span>Enroll New Student</span>
      </a>
    </div>
  </div>

  <!-- Search & Filter Form (Demonstrating GET Form Submission) -->
  <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200 mb-6">
    <form action="/students" method="GET" class="flex flex-col md:flex-row gap-3 items-center">
      
      <!-- Text Search Query -->
      <div class="relative flex-grow w-full">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-xs">
          <i class="fa-solid fa-magnifying-glass"></i>
        </span>
        <input 
          type="text" 
          name="q" 
          value="<%= searchQuery %>" 
          placeholder="Search by name, roll number, or email..." 
          class="w-full pl-9 pr-3 py-2 text-xs border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none"
        >
      </div>

      <!-- Class Filter Dropdown -->
      <div class="w-full md:w-56">
        <select 
          name="grade" 
          class="w-full py-2 px-3 text-xs border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none bg-white"
        >
          <option value="">All Classes</option>
          <option value="Grade 10-A" <%= selectedGrade === 'Grade 10-A' ? 'selected' : '' %>>Grade 10-A</option>
          <option value="Grade 10-B" <%= selectedGrade === 'Grade 10-B' ? 'selected' : '' %>>Grade 10-B</option>
          <option value="Grade 9-A" <%= selectedGrade === 'Grade 9-A' ? 'selected' : '' %>>Grade 9-A</option>
          <option value="Grade 9-B" <%= selectedGrade === 'Grade 9-B' ? 'selected' : '' %>>Grade 9-B</option>
          <option value="Grade 11-Science" <%= selectedGrade === 'Grade 11-Science' ? 'selected' : '' %>>Grade 11-Science</option>
        </select>
      </div>

      <!-- Submit & Reset Buttons -->
      <div class="flex items-center gap-2 w-full md:w-auto">
        <button 
          type="submit" 
          class="w-full md:w-auto px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-lg text-xs font-semibold transition flex items-center justify-center gap-1.5"
        >
          <i class="fa-solid fa-filter text-[10px]"></i>
          <span>Filter (GET)</span>
        </button>

        <% if (searchQuery || selectedGrade) { %>
          <a 
            href="/students" 
            class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg text-xs font-medium transition"
            title="Clear filters"
          >
            Clear
          </a>
        <% } %>
      </div>

    </form>
    
    <div class="mt-2 text-[11px] text-slate-400 flex items-center justify-between">
      <span>Demonstrating <strong>GET</strong> Form Submission: Query parameters sent via URL query string (<code class="font-mono text-indigo-600">req.query</code>)</span>
      <span>Showing <strong><%= students.length %></strong> of <%= totalCount %> records</span>
    </div>
  </div>

  <!-- Students Table (Server-Side Rendered) -->
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-600 uppercase font-semibold tracking-wider border-b border-slate-200">
          <tr>
            <th class="py-3 px-4">Roll No</th>
            <th class="py-3 px-4">Student Details</th>
            <th class="py-3 px-4">Class / Grade</th>
            <th class="py-3 px-4">Gender</th>
            <th class="py-3 px-4">Contact</th>
            <th class="py-3 px-4 text-center">Attendance %</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (students.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center py-12">
                <div class="max-w-sm mx-auto text-slate-400">
                  <i class="fa-solid fa-folder-open text-4xl mb-3 text-slate-300"></i>
                  <p class="text-sm font-medium text-slate-600">No students found matching your criteria</p>
                  <p class="text-xs text-slate-400 mt-1">Try clearing filters or add a new student using the enrollment form.</p>
                  <a href="/" class="inline-block mt-4 px-4 py-2 bg-indigo-600 text-white rounded-lg text-xs font-semibold">
                    Go to Enrollment Form
                  </a>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% students.forEach(function(student) { %>
              <tr class="hover:bg-slate-50/80 transition">
                <!-- Roll No -->
                <td class="py-3.5 px-4 font-mono font-bold text-indigo-700">
                  <%= student.rollNo %>
                </td>

                <!-- Name & Email -->
                <td class="py-3.5 px-4">
                  <div class="font-bold text-slate-900"><%= student.fullName %></div>
                  <div class="text-[11px] text-slate-500 font-mono"><%= student.email %></div>
                </td>

                <!-- Grade -->
                <td class="py-3.5 px-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                    <%= student.grade %>
                  </span>
                </td>

                <!-- Gender -->
                <td class="py-3.5 px-4 text-slate-600">
                  <%= student.gender %>
                </td>

                <!-- Contact -->
                <td class="py-3.5 px-4 text-slate-600 font-mono text-[11px]">
                  <%= student.contactNumber %>
                </td>

                <!-- Attendance Rate -->
                <td class="py-3.5 px-4 text-center">
                  <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold <%= student.attendanceRate >= 75 ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200' %>">
                    <% if (student.attendanceRate >= 75) { %>
                      <i class="fa-solid fa-circle-check text-[10px]"></i>
                    <% } else { %>
                      <i class="fa-solid fa-triangle-exclamation text-[10px]"></i>
                    <% } %>
                    <span><%= student.attendanceRate %>%</span>
                  </div>
                </td>

                <!-- Status -->
                <td class="py-3.5 px-4">
                  <span class="text-[11px] font-semibold <%= student.status === 'Active' ? 'text-emerald-600' : 'text-rose-600' %>">
                    <%= student.status %>
                  </span>
                  <div class="text-[10px] text-slate-400">Added: <%= student.enrolledAt %></div>
                </td>

                <!-- Action: Form Submission (POST to delete) -->
                <td class="py-3.5 px-4 text-right">
                  <form action="/students/delete/<%= student.id %>" method="POST" onsubmit="return confirm('Remove student <%= student.fullName %>?');" class="inline">
                    <button 
                      type="submit" 
                      class="px-2.5 py-1 text-rose-600 hover:text-rose-800 hover:bg-rose-50 rounded border border-rose-200 transition text-[11px] font-medium"
                      title="Delete student record"
                    >
                      <i class="fa-solid fa-trash-can mr-1"></i> Delete
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</main>

<%- include('partials/footer') %>
