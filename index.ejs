<%- include('partials/header') %>

<main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <!-- ================= SSR CONCEPT BANNER ================= -->
  <div class="mb-8 bg-gradient-to-r from-indigo-900 via-slate-900 to-indigo-950 text-white rounded-2xl p-6 shadow-xl border border-indigo-800/40 relative overflow-hidden">
    <div class="absolute -right-8 -bottom-8 opacity-10 text-9xl">
      <i class="fa-solid fa-server"></i>
    </div>
    
    <div class="relative z-10">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="px-3 py-1 rounded-full text-xs font-bold tracking-wide uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
          <i class="fa-solid fa-check-circle mr-1"></i> Task 1 Architecture
        </span>
        <span class="px-3 py-1 rounded-full text-xs font-mono bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
          Node.js + Express + EJS Templates
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-2">
        Server-Side Rendering (SSR) & HTML Form Handling
      </h1>
      <p class="text-indigo-200 text-sm sm:text-base max-w-3xl leading-relaxed mb-4">
        In this application, the HTML is assembled and rendered <strong>directly on the Node.js server</strong> using the EJS templating engine before being transmitted to your browser. When you submit forms below, the browser sends an HTTP POST request with URL-encoded data, which Express parses into <code class="bg-indigo-950/70 px-1.5 py-0.5 rounded text-amber-300 font-mono">req.body</code> and renders back into dynamic views.
      </p>

      <!-- 4 Steps Visual Flow -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-3 border-t border-indigo-800/60 text-xs">
        <div class="bg-slate-800/60 rounded-xl p-3 border border-indigo-500/20">
          <span class="text-indigo-400 font-bold block mb-1">Step 1: HTML Forms</span>
          <span class="text-slate-300">Semantic inputs (<code class="text-amber-300">&lt;input&gt;</code>, <code class="text-amber-300">&lt;select&gt;</code>, <code class="text-amber-300">&lt;textarea&gt;</code>) collecting user input.</span>
        </div>
        <div class="bg-slate-800/60 rounded-xl p-3 border border-indigo-500/20">
          <span class="text-emerald-400 font-bold block mb-1">Step 2: Express Server</span>
          <span class="text-slate-300">Lightweight Node.js HTTP server running on port 3000 handling incoming requests.</span>
        </div>
        <div class="bg-slate-800/60 rounded-xl p-3 border border-indigo-500/20">
          <span class="text-amber-400 font-bold block mb-1">Step 3: Server Endpoints</span>
          <span class="text-slate-300">Routes like <code class="text-amber-300">app.post('/submit-student')</code> consuming form payload via <code class="text-amber-300">express.urlencoded()</code>.</span>
        </div>
        <div class="bg-slate-800/60 rounded-xl p-3 border border-indigo-500/20">
          <span class="text-cyan-400 font-bold block mb-1">Step 4: SSR with EJS</span>
          <span class="text-slate-300">Dynamic HTML injection via <code class="text-amber-300">&lt;%= %&gt;</code> tags, loops, and conditional layouts.</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= DYNAMIC SUMMARY STATS CARDS (SSR) ================= -->
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Enrolled</p>
        <h3 class="text-2xl font-black text-slate-800 mt-1"><%= stats.totalStudents %> Students</h3>
        <p class="text-xs text-indigo-600 mt-1"><i class="fa-solid fa-server mr-1"></i>Rendered by EJS</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl">
        <i class="fa-solid fa-users"></i>
      </div>
    </div>

    <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Average Attendance</p>
        <h3 class="text-2xl font-black text-emerald-600 mt-1"><%= stats.avgAttendance %>%</h3>
        <p class="text-xs text-emerald-600 mt-1"><i class="fa-solid fa-chart-line mr-1"></i>Computed on Server</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
        <i class="fa-solid fa-chart-pie"></i>
      </div>
    </div>

    <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Pending Leaves</p>
        <h3 class="text-2xl font-black text-amber-600 mt-1"><%= stats.pendingLeaves %> Requests</h3>
        <p class="text-xs text-amber-600 mt-1"><i class="fa-solid fa-clock mr-1"></i>Awaiting Review</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
        <i class="fa-solid fa-file-signature"></i>
      </div>
    </div>

    <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Leave History</p>
        <h3 class="text-2xl font-black text-purple-600 mt-1"><%= stats.totalLeaves %> Filed</h3>
        <p class="text-xs text-purple-600 mt-1"><i class="fa-solid fa-database mr-1"></i>Server-side state</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl">
        <i class="fa-solid fa-folder-tree"></i>
      </div>
    </div>
  </section>

  <!-- ================= STEP 1 & STEP 3: HTML FORMS FOR USER INPUT ================= -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">

    <!-- FORM 1: Student Enrollment Form (POST to /submit-student) -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex flex-col">
      <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
            <i class="fa-solid fa-user-plus"></i>
          </div>
          <div>
            <h2 class="text-lg font-bold text-slate-800">Form 1: Student Enrollment</h2>
            <p class="text-xs text-slate-500">Method: <span class="font-mono font-bold text-indigo-600">POST</span> &bull; Action: <span class="font-mono text-slate-700">/submit-student</span></p>
          </div>
        </div>
        <span class="text-[11px] font-mono bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded border border-indigo-200">
          application/x-www-form-urlencoded
        </span>
      </div>

      <form action="/submit-student" method="POST" class="space-y-4 flex-grow flex flex-col justify-between">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Student Full Name -->
          <div>
            <label for="fullName" class="block text-xs font-semibold text-slate-700 mb-1">
              Full Name <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-xs">
                <i class="fa-solid fa-user"></i>
              </span>
              <input 
                type="text" 
                id="fullName" 
                name="fullName" 
                required 
                placeholder="e.g. Priya Sharma" 
                class="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"
              >
            </div>
          </div>

          <!-- Roll Number -->
          <div>
            <label for="rollNo" class="block text-xs font-semibold text-slate-700 mb-1">
              Roll / ID Number <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-xs">
                <i class="fa-solid fa-id-badge"></i>
              </span>
              <input 
                type="text" 
                id="rollNo" 
                name="rollNo" 
                required 
                placeholder="e.g. 10A-15" 
                class="w-full pl-9 pr-3 py-2 text-sm font-mono uppercase border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"
              >
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Email Address -->
          <div>
            <label for="email" class="block text-xs font-semibold text-slate-700 mb-1">
              Email Address <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-xs">
                <i class="fa-solid fa-envelope"></i>
              </span>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="student@school.edu" 
                class="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"
              >
            </div>
          </div>

          <!-- Class / Grade Dropdown -->
          <div>
            <label for="grade" class="block text-xs font-semibold text-slate-700 mb-1">
              Grade / Class <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-xs">
                <i class="fa-solid fa-chalkboard"></i>
              </span>
              <select 
                id="grade" 
                name="grade" 
                required 
                class="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none bg-white transition"
              >
                <option value="">Select a Grade...</option>
                <option value="Grade 10-A">Grade 10-A (Advisory: Mrs. Jenkins)</option>
                <option value="Grade 10-B">Grade 10-B (Advisory: Mr. Miller)</option>
                <option value="Grade 9-A">Grade 9-A (Advisory: Dr. Chen)</option>
                <option value="Grade 9-B">Grade 9-B (Advisory: Ms. Watson)</option>
                <option value="Grade 11-Science">Grade 11-Science</option>
                <option value="Grade 12-Commerce">Grade 12-Commerce</option>
              </select>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Guardian Phone -->
          <div>
            <label for="contactNumber" class="block text-xs font-semibold text-slate-700 mb-1">
              Guardian Phone Number
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-xs">
                <i class="fa-solid fa-phone"></i>
              </span>
              <input 
                type="tel" 
                id="contactNumber" 
                name="contactNumber" 
                placeholder="+91 98765 00000" 
                class="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"
              >
            </div>
          </div>

          <!-- Initial Attendance Rate % -->
          <div>
            <label for="initialRate" class="block text-xs font-semibold text-slate-700 mb-1">
              Initial Attendance Rate (%)
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-xs">
                <i class="fa-solid fa-percent"></i>
              </span>
              <input 
                type="number" 
                id="initialRate" 
                name="initialRate" 
                min="0" 
                max="100" 
                value="95" 
                class="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"
              >
            </div>
          </div>
        </div>

        <!-- Gender Radio Selection -->
        <div>
          <span class="block text-xs font-semibold text-slate-700 mb-1.5">Gender</span>
          <div class="flex items-center space-x-6 text-sm text-slate-600">
            <label class="inline-flex items-center cursor-pointer">
              <input type="radio" name="gender" value="Male" checked class="text-indigo-600 focus:ring-indigo-500">
              <span class="ml-2 text-xs">Male</span>
            </label>
            <label class="inline-flex items-center cursor-pointer">
              <input type="radio" name="gender" value="Female" class="text-indigo-600 focus:ring-indigo-500">
              <span class="ml-2 text-xs">Female</span>
            </label>
            <label class="inline-flex items-center cursor-pointer">
              <input type="radio" name="gender" value="Other" class="text-indigo-600 focus:ring-indigo-500">
              <span class="ml-2 text-xs">Other</span>
            </label>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
          <p class="text-[11px] text-slate-400">
            Submits HTTP POST to <code class="text-slate-600 font-mono">/submit-student</code>
          </p>
          <button 
            type="submit" 
            class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg shadow-sm hover:shadow transition flex items-center space-x-2"
          >
            <i class="fa-solid fa-paper-plane text-xs"></i>
            <span>Enroll Student (POST)</span>
          </button>
        </div>

      </form>
    </div>

    <!-- FORM 2: Leave Application Form (POST to /submit-leave) -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex flex-col">
      <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
            <i class="fa-solid fa-envelope-open-text"></i>
          </div>
          <div>
            <h2 class="text-lg font-bold text-slate-800">Form 2: Leave Application</h2>
            <p class="text-xs text-slate-500">Method: <span class="font-mono font-bold text-amber-600">POST</span> &bull; Action: <span class="font-mono text-slate-700">/submit-leave</span></p>
          </div>
        </div>
        <span class="text-[11px] font-mono bg-amber-50 text-amber-700 px-2 py-0.5 rounded border border-amber-200">
          Form Body Processing
        </span>
      </div>

      <form action="/submit-leave" method="POST" class="space-y-4 flex-grow flex flex-col justify-between">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Student Name -->
          <div>
            <label for="leaveStudentName" class="block text-xs font-semibold text-slate-700 mb-1">
              Student Full Name <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-xs">
                <i class="fa-solid fa-user-graduate"></i>
              </span>
              <input 
                type="text" 
                id="leaveStudentName" 
                name="studentName" 
                required 
                placeholder="e.g. Aarav Sharma" 
                class="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition"
              >
            </div>
          </div>

          <!-- Roll Number -->
          <div>
            <label for="leaveRollNo" class="block text-xs font-semibold text-slate-700 mb-1">
              Roll / ID Number <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-xs">
                <i class="fa-solid fa-barcode"></i>
              </span>
              <input 
                type="text" 
                id="leaveRollNo" 
                name="rollNo" 
                required 
                placeholder="e.g. 10A-01" 
                class="w-full pl-9 pr-3 py-2 text-sm font-mono uppercase border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition"
              >
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Leave Category Dropdown -->
          <div>
            <label for="category" class="block text-xs font-semibold text-slate-700 mb-1">
              Leave Category <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-xs">
                <i class="fa-solid fa-tag"></i>
              </span>
              <select 
                id="category" 
                name="category" 
                required 
                class="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none bg-white transition"
              >
                <option value="Medical">Medical / Health Issue</option>
                <option value="Competition">Inter-School Competition</option>
                <option value="Family Function">Family Event / Function</option>
                <option value="Personal">Personal / Urgent Work</option>
                <option value="Bereavement">Bereavement</option>
              </select>
            </div>
          </div>

          <!-- Start Date -->
          <div>
            <label for="startDate" class="block text-xs font-semibold text-slate-700 mb-1">
              Start Date <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-xs">
                <i class="fa-regular fa-calendar"></i>
              </span>
              <input 
                type="date" 
                id="startDate" 
                name="startDate" 
                required 
                value="2026-10-05" 
                class="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition"
              >
            </div>
          </div>
        </div>

        <!-- Duration Days -->
        <div>
          <label for="daysCount" class="block text-xs font-semibold text-slate-700 mb-1">
            Number of Days <span class="text-rose-500">*</span>
          </label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-xs">
              <i class="fa-solid fa-hourglass-half"></i>
            </span>
            <input 
              type="number" 
              id="daysCount" 
              name="daysCount" 
              min="1" 
              max="30" 
              value="1" 
              required 
              class="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition"
            >
          </div>
        </div>

        <!-- Detailed Reason Textarea -->
        <div>
          <label for="reason" class="block text-xs font-semibold text-slate-700 mb-1">
            Reason & Supporting Details <span class="text-rose-500">*</span>
          </label>
          <textarea 
            id="reason" 
            name="reason" 
            rows="3" 
            required 
            placeholder="Please specify why the leave of absence is required..." 
            class="w-full p-3 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
          <p class="text-[11px] text-slate-400">
            Submits HTTP POST to <code class="text-slate-600 font-mono">/submit-leave</code>
          </p>
          <button 
            type="submit" 
            class="px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold rounded-lg shadow-sm hover:shadow transition flex items-center space-x-2"
          >
            <i class="fa-solid fa-file-arrow-up text-xs"></i>
            <span>Submit Application (POST)</span>
          </button>
        </div>

      </form>
    </div>

  </div>

  <!-- ================= DYNAMIC ACTIVITY PANELS (RENDERED BY EJS) ================= -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">

    <!-- RECENT ENROLLMENTS (EJS LOOP) -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-base font-bold text-slate-800 flex items-center gap-2">
            <i class="fa-solid fa-list-check text-indigo-600"></i>
            Recently Enrolled Students (SSR Loop)
          </h3>
          <p class="text-xs text-slate-500">Rendered on server via <code class="font-mono text-indigo-600">&lt;% recentStudents.forEach() %&gt;</code></p>
        </div>
        <a href="/students" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 flex items-center gap-1">
          View All <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="bg-slate-50 text-slate-500 uppercase tracking-wider border-y border-slate-200">
              <th class="py-2.5 px-3">Roll #</th>
              <th class="py-2.5 px-3">Name</th>
              <th class="py-2.5 px-3">Grade</th>
              <th class="py-2.5 px-3 text-right">Attendance</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (recentStudents.length === 0) { %>
              <tr>
                <td colspan="4" class="text-center py-6 text-slate-400">No students enrolled yet.</td>
              </tr>
            <% } else { %>
              <% recentStudents.forEach(function(student) { %>
                <tr class="hover:bg-slate-50/70 transition">
                  <td class="py-2.5 px-3 font-mono font-bold text-indigo-600"><%= student.rollNo %></td>
                  <td class="py-2.5 px-3 font-medium text-slate-800"><%= student.fullName %></td>
                  <td class="py-2.5 px-3 text-slate-600"><%= student.grade %></td>
                  <td class="py-2.5 px-3 text-right">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold <%= student.attendanceRate >= 75 ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200' %>">
                      <%= student.attendanceRate %>%
                    </span>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- RECENT LEAVE REQUESTS (EJS LOOP) -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-base font-bold text-slate-800 flex items-center gap-2">
            <i class="fa-solid fa-clock-rotate-left text-amber-600"></i>
            Recent Leave Applications (SSR Loop)
          </h3>
          <p class="text-xs text-slate-500">Rendered on server via <code class="font-mono text-amber-600">&lt;% recentLeaves.forEach() %&gt;</code></p>
        </div>
        <a href="/leave-requests" class="text-xs font-semibold text-amber-600 hover:text-amber-800 flex items-center gap-1">
          Review Requests <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>

      <div class="space-y-3">
        <% if (recentLeaves.length === 0) { %>
          <div class="text-center py-6 text-slate-400 text-xs">No leave requests pending.</div>
        <% } else { %>
          <% recentLeaves.forEach(function(leave) { %>
            <div class="p-3 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-slate-50 transition flex items-center justify-between gap-3 text-xs">
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-bold text-slate-800"><%= leave.studentName %></span>
                  <span class="font-mono text-[11px] text-slate-500">(<%= leave.rollNo %>)</span>
                  <span class="px-2 py-0.5 rounded bg-indigo-50 text-indigo-700 text-[10px] font-medium border border-indigo-200"><%= leave.category %></span>
                </div>
                <p class="text-slate-500 mt-1 line-clamp-1"><%= leave.reason %></p>
              </div>
              <div class="text-right flex-shrink-0">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold <%= leave.status === 'Approved' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : (leave.status === 'Rejected' ? 'bg-rose-50 text-rose-700 border border-rose-200' : 'bg-amber-50 text-amber-700 border border-amber-200') %>">
                  <%= leave.status %>
                </span>
                <p class="text-[10px] text-slate-400 mt-1"><%= leave.daysCount %> day(s)</p>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

  </div>

</main>

<%- include('partials/footer') %>
